# vLLM (Dockerfile entrypoint, main.py)
VLLM_PORT=30024
OLMOCR_MODEL_PATH=allenai/olmOCR-2-7B-1025-FP8
TENSOR_PARALLEL_SIZE=1
DATA_PARALLEL_SIZE=1
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.95
MAX_SERVER_READY_TIMEOUT=600

# OLMOCR (main.py)
TARGET_LONGEST_IMAGE_DIM=1288
OLMOCR_MODEL=olmocr

# Kelpie
KELPIE_API_URL=https://kelpie.saladexamples.com
KELPIE_LOG_LEVEL=info
KELPIE_RECREATE_BETWEEN_JOBS=false
KELPIE_STATE_FILE=./kelpie-state.json
MAX_JOB_FAILURES=3
MAX_RETRIES=3
MAX_TIME_WITH_NO_WORK_S=0

# File watcher (debounce and stability checks)
FILE_WATCHER_DEBOUNCE_MS=0
FILE_WATCHER_MAX_WAIT_MS=5000
FILE_WATCHER_STABILITY_CHECK_MS=50

# --- Required: complete these before use ---
# S3/R2 (main.py download_file, upload_file)
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Kelpie / Salad (for Kelpie deployment)
KELPIE_API_KEY=
SALAD_API_KEY=
SALAD_CONTAINER_GROUP_ID=
SALAD_MACHINE_ID=
SALAD_ORGANIZATION_NAME=
SALAD_PROJECT_NAME=
